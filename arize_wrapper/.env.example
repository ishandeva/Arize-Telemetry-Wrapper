# Copy these values to the deployment's secret manager or local .env file.
# Never commit a real ARIZE_API_KEY.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=

# Required organization-standard attributes.
ARIZE_SERVICE_NAME=
ARIZE_DEPLOYMENT_ENVIRONMENT=development
ARIZE_TENANT=

# Optional operational settings.
ARIZE_SERVICE_VERSION=
# Configure only for a supported private/on-prem Arize endpoint.
ARIZE_ENDPOINT=
ARIZE_ENABLED=true
# Use true only when service owners have approved telemetry failures as non-fatal.
ARIZE_FAIL_SILENTLY=false
